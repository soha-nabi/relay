# Relay Recovery Engine - Environment Configuration Example
# Copy this file to .env and fill in your values.
# NEVER commit .env with real credentials to version control.

# ─── Application ───────────────────────────────────────────────────────────
PORT=8000
ENVIRONMENT=development

# ─── MongoDB (Optional) ────────────────────────────────────────────────────
# Leave MONGODB_URI blank to run entirely on the in-memory DataStore (default
# for local development and unit tests). When set, the MongoDB adapter
# becomes available for persistent sessions, automations, and recovery.
#
# Format: mongodb://[user:password@]host[:port][/authdb][?options]
# Atlas:  mongodb+srv://user:password@cluster.mongodb.net/
MONGODB_URI=

# Database name to use inside the MongoDB instance.
MONGODB_DB_NAME=relay

# ─── Webhook Tunnel & Endpoint ─────────────────────────────────────────────
# Public HTTPS webhook URL for external payment gateways (e.g., Razorpay/Stripe).
# Update with your live ngrok/tunnel domain when testing live gateway callbacks.
WEBHOOK_PUBLIC_URL=https://your-tunnel-subdomain.ngrok-free.app/webhooks/payment

# Set to 'true' in production to enforce HMAC-SHA256 signature verification.
# In demo/development mode (default), signatures are not required.
WEBHOOK_VERIFY_SIGNATURES=false
WEBHOOK_SECRET=
