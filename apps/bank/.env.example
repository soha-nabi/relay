# Bank Gateway Next.js Application - Environment Variables
# Copy to .env.local for local development or set in Vercel Project Settings

# URL of the FastAPI Backend (Render deployment in production)
NEXT_PUBLIC_RELAY_API_URL=http://localhost:8000

# URL of the Relay Next.js App for customer redirection after bank authorization
NEXT_PUBLIC_RELAY_APP_URL=http://localhost:3000
