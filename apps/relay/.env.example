# Relay Next.js Application - Environment Variables
# Copy to .env.local for local development or set in Vercel Project Settings

# URL of the FastAPI Backend (Render deployment in production)
NEXT_PUBLIC_API_URL=http://localhost:8000

# URL of the separate Bank Gateway Next.js App (Vercel deployment in production)
NEXT_PUBLIC_BANK_URL=http://localhost:3001

# (Optional) ElevenLabs Conversational AI Agent ID for Voice Recovery Agent
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=
